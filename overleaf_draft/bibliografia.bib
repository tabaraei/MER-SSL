	langid = {english},
	file = {PDF:C\:\\Users\\Robin_T480\\Zotero\\storage\\NTSYF3N2\\Gagneré et al. - 2024 - Adapting Pitch-Based Self Supervised Learning Models for Tempo Estimation.pdf:application/pdf},
