	file = {PDF:C\:\\Users\\Robin_T480\\Zotero\\storage\\DERP9I85\\Li et al. - 2022 - MAP-Music2Vec A Simple and Effective Baseline for Self-Supervised Music Audio Representation Learni.pdf:application/pdf},
