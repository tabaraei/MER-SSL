% Phase C — Ante-Hoc Explanation (TikZ).
% Requires in the preamble:
%   \usepackage{tikz}
%   \usetikzlibrary{positioning,calc,fit,backgrounds,arrows.meta,shadows,decorations.pathreplacing}
\definecolor{cFroz}{HTML}{E5E7EB}\definecolor{dFroz}{HTML}{9CA3AF}
\definecolor{cTrn}{HTML}{D1FAE5} \definecolor{dTrn}{HTML}{10B981}
\definecolor{cLat}{HTML}{FEF3C7} \definecolor{dLat}{HTML}{D97706}
\definecolor{cOut}{HTML}{FEE2E2} \definecolor{dOut}{HTML}{EF4444}
\definecolor{cDat}{HTML}{DBEAFE} \definecolor{dDat}{HTML}{3B82F6}
\definecolor{cSec}{HTML}{F1F5F9} \definecolor{dSec}{HTML}{CBD5E1}
\definecolor{cWk}{HTML}{F3F4F6}  \definecolor{dWk}{HTML}{9CA3AF}
\begin{tikzpicture}[
    font=\scriptsize,
    >={Stealth[length=2mm]},
    base/.style={rounded corners=2pt, draw, line width=0.5pt, align=center,
                 minimum width=20mm, minimum height=8mm, inner sep=2pt},
    enc/.style ={base, fill=cFroz, draw=dFroz},
    trn/.style ={base, fill=cTrn,  draw=dTrn},
    lat/.style ={base, fill=cLat,  draw=dLat, line width=0.9pt, font=\scriptsize\bfseries},
    outp/.style={base, fill=cOut,  draw=dOut},
    dat/.style ={base, fill=cDat,  draw=dDat},
    wk/.style  ={base, fill=cWk,   draw=dWk, text=black!55},
    flow/.style={->, line width=0.7pt, draw=black!65},
    tag/.style ={midway, font=\tiny\itshape, text=black!60, fill=white, inner sep=1pt},
  ]

  % ---------- shared encoder block ----------
  \node[dat] (corp) at (0,2.4)  {Corpus\\767 excerpts};
  \node[dat] (qry)  at (0,-0.8) {Query\\excerpt};

  \node[enc] (encb) at (3.0,2.4)  {Phase B encoder\\\emph{(reused, frozen)}};
  \node[enc] (encq) at (3.0,-0.8) {Phase B encoder\\\emph{(reused, frozen)}};

  \node[lat] (idx) at (6.1,2.4)  {Latent index\\unit-sphere};
  \node[lat] (qz)  at (6.1,-0.8) {Query latent\\$\mathbf{z}\in\mathbb{R}^{128}$};

  % shared-weights symmetry link
  \draw[<->, dashed, draw=dFroz] (encb.south) -- (encq.north)
        node[midway, fill=white, inner sep=1pt, font=\tiny\itshape, text=black!60, align=center]
        {shared weights\\build = query};

  % ---------- Channel 1: retrieval ----------
  \node[trn]  (knn) at (9.4,1.6)  {Cosine $k$-NN\\inner product};
  \node[outp] (nb)  at (12.4,1.6) {Nearest neighbours\\+ contrastive foils};

  % ---------- Channel 2: ProtoPNet ----------
  \node[trn]  (proto) at (9.4,-3.4) {Learnable prototype bank\\$m$/quadrant, $4m$ total};
  \node[trn]  (dist)  at (9.4,-1.4) {Distance to prototypes\\$d_j=\lVert\mathbf{z}-\mathbf{p}_j\rVert^2$};
  \node[trn]  (logit) at (12.4,-1.4){Identity-prior linear\\$\to$ quadrant logits};
  \node[outp] (prof)  at (15.2,-1.4){Per-prototype profile\\+ quadrant prediction};

  % ---------- surpassed baseline ----------
  \node[wk] (cent) at (12.4,3.6) {Static 4-centroid readout\\post-hoc baseline \emph{(surpassed)}};

  % ---------- prototype colour chips (quadrant cue) ----------
  \begin{scope}[on background layer]
    \foreach \i/\c in {0/dOut,1/dDat,2/dTrn,3/dLat}{
      \fill[\c] ($(proto.north west)+(2pt+\i*3.4pt,-2pt)$) rectangle ++(2.6pt,2.6pt);
    }
  \end{scope}

  % ---------- edges ----------
  \draw[flow] (corp) -- (encb);
  \draw[flow] (qry)  -- (encq);
  \draw[flow] (encb) -- (idx);
  \draw[flow] (encq) -- (qz);

  \draw[flow] (idx) -- (knn) node[tag]{index};
  \draw[flow] (qz)  -- (knn) node[tag]{query};
  \draw[flow] (knn) -- (nb);

  \draw[flow] (qz)    |- (dist);
  \draw[flow] (proto) -- (dist);
  \draw[flow] (dist)  -- (logit);
  \draw[flow] (logit) -- (prof);

  \draw[->, dashed, draw=dWk] (idx) -- (cent) node[tag]{mean / quadrant};

  % ---------- section backgrounds ----------
  \begin{scope}[on background layer]
    \node[fill=cSec, rounded corners=4pt, fit=(corp)(qry)(encb)(encq)(idx)(qz),
          inner sep=8pt,
          label={[font=\scriptsize\bfseries,text=black!55]above:Shared Phase B encoder (reused unchanged)}] {};
    \node[fill=cSec, rounded corners=4pt, fit=(knn)(nb),
          inner sep=7pt,
          label={[font=\scriptsize\bfseries,text=black!55]above:Channel 1 — example-based retrieval}] {};
    \node[fill=cSec, rounded corners=4pt, fit=(proto)(dist)(logit)(prof),
          inner sep=7pt,
          label={[font=\scriptsize\bfseries,text=black!55]below:Channel 2 — Audio ProtoPNet}] {};
  \end{scope}

\end{tikzpicture}
