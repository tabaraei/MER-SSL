%% Figure 3 (Ch. 4, fig:system-overview) — GENERAL end-to-end overview.
%% High-level by design: detailed module-level pipelines for Phase B and Phase C
%% are given in their own figures. The shared 128-d latent produced in Phase B is
%% reused unchanged as the Phase C retrieval index. Regression, not classification.
flowchart LR
  classDef data fill:#E8F0FE,stroke:#1B3A6B,color:#1B3A6B,font-weight:bold;
  classDef phase fill:#ECFDF5,stroke:#10B981,color:#065F46;
  classDef latent fill:#FEF3C7,stroke:#B45309,color:#7C2D12,font-weight:bold;
  classDef out fill:#FDE8E8,stroke:#C0392B,color:#7F1D1D;

  AUD(["PMEmo 2019<br/>music audio (767 excerpts)"]):::data

  A["<b>Phase A</b><br/>Representation Probing<br/><br/>frozen MERT + linear probes<br/>diagnose music-theory gaps"]:::phase
  B["<b>Phase B</b><br/>Multi-Encoder Affective Regressor<br/><br/>frozen MERT + wav2vec2 + theory<br/>layer fusion to a shared latent"]:::phase
  Z["Shared 128-d<br/>latent space"]:::latent
  C["<b>Phase C</b><br/>Ante-Hoc Explanation<br/><br/>k-NN retrieval + Audio ProtoPNet<br/>real neighbours as the explanation"]:::phase

  VA["Valence-Arousal<br/>prediction"]:::out
  EX["Example-based<br/>explanation"]:::out

  AUD --> A
  AUD --> B
  A -.->|gaps re-injected as features| B
  B --> Z
  Z --> VA
  Z ==>|reused unchanged| C
  C --> EX
